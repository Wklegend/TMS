  t.rows = t.rows.filter(function (r) { const k = String(r[i.setting_key]); return k !== key && k.indexOf(pre) !== 0; }); this.dirty.app_settings = true;
  if (val == null) return; const json = JSON.stringify(val); const now = nowIso_();
  const add = function (k, v) { const r = t.head.map(function () { return ''; }); r[i.setting_key] = k; r[i.value_json] = v; r[i.updated_at] = now; t.rows.push(r); };
