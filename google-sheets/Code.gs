/* =================== web API =================== */
function doGet() { return out_({ ok: true, app: 'TMS', schema: 2, time: new Date().toISOString() }); }
function doPost(e) {
  try {
    const req = JSON.parse(e.postData.contents);
    const token = PropertiesService.getScriptProperties().getProperty('TOKEN');
    if (!token || req.token !== token) return out_({ ok: false, error: 'unauthorized' });
    if (req.op === 'ping') return out_({ ok: true, schema: 2, time: new Date().toISOString() });
    const lock = LockService.getScriptLock(); lock.waitLock(25000);
    try {
      const db = new Db_();
      if (req.op === 'load') return out_({ ok: true, docs: db.loadAll() });
      if (req.op === 'batch') { const failed = []; (req.writes || []).forEach(function (w) { try { db.write(w); } catch (e) { failed.push({ path: w.path, error: String(e && e.message || e) }); } }); db.flush(); return out_({ ok: true, n: (req.writes || []).length - failed.length, failed: failed }); }
      return out_({ ok: false, error: 'bad_op' });
