  const row = t.head.map(function () { return ''; }); const id = 'd-' + Utilities.getUuid().slice(0, 8);
  row[i.id] = id; row[i.name] = name; row[i.created_at] = nowIso_(); row[i.updated_at] = nowIso_(); row[i.source] = 'auto';
