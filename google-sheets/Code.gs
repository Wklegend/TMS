    const kids = {}; def.children.forEach(function (ch) { const ct = self.t(ch.table); const g = {}; ct.rows.forEach(function (r) { (g[r[ct.ix[ch.fk]]] = g[r[ct.ix[ch.fk]]] || []).push(r); }); kids[ch.table] = { t: ct, g: g }; });
