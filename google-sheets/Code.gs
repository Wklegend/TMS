Db_.prototype.loadAll = function () {
  const self = this; const docs = {};
  const logs = {}; const lt = this.t('activity_log');
  lt.rows.forEach(function (r) { const k = r[lt.ix.entity_type] + '|' + r[lt.ix.entity_id]; (logs[k] = logs[k] || []).push({ seq: +r[lt.ix.seq] || 0, at: r[lt.ix.logged_at], text: r[lt.ix.message] }); });
