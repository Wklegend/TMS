/* =================== import from Monthly Tasks Tracker → All =================== */
function importTrackerAll() {
  const src = SpreadsheetApp.openById(TRACKER_ID).getSheetByName(TRACKER_SHEET);
  if (!src) throw new Error('لم أجد ورقة ' + TRACKER_SHEET);
  const vals = src.getDataRange().getDisplayValues(); const raw = src.getDataRange().getValues();
  let hr = -1; for (var r = 0; r < Math.min(40, vals.length); r++) if (vals[r].some(function (c) { return String(c).trim().toLowerCase() === 'tasks'; })) { hr = r; break; }
  if (hr < 0) throw new Error('لم أجد صف العناوين (Tasks)');
  const H = vals[hr].map(function (c) { return String(c).trim().toLowerCase(); });
  const col = function (names) { for (var i = 0; i < H.length; i++) if (names.indexOf(H[i]) >= 0) return i; return -1; };
  const C = { year: col(['year']), no: col(['#']), title: col(['tasks', 'task']), month: col(['month']), dept: col(['department']), entry: col(['entry date']), due: col(['deadline']), emp: col(['employee name']), status: col(['status']) };
  const SM = { 'not started': 'todo', 'in progress': 'doing', 'complete': 'done', 'completed': 'done', 'on hold': 'hold', 'cancelled': 'cancel' };
  const db = new Db_(); const docs = db.loadAll();
  const people = {}, keys = {}; let maxT = 0, maxE = 0;
  Object.keys(docs).forEach(function (p) {
    const d = docs[p];
    if (p.indexOf('ws/main/people/') === 0) { people[String(d.name || '').trim().toLowerCase()] = p.split('/')[3]; maxE = Math.max(maxE, +(String(d.code || '').split('-')[1]) || 0); }
    if (p.indexOf('ws/main/tasks/') === 0) { maxT = Math.max(maxT, +(String(d.code || '').split('-')[1]) || 0); }
  });
  Object.keys(docs).forEach(function (p) { if (p.indexOf('ws/main/tasks/') === 0) { const d = docs[p]; keys[key_(d.title, d.due, nameOf_(docs, d.assignee))] = true; } });
  const fmtD = function (v) { if (v && typeof v.getTime === 'function' && !isNaN(v.getTime())) return Utilities.formatDate(v, Session.getScriptTimeZone(), 'yyyy-MM-dd'); return ''; };
  let added = 0, skipped = 0; const batch = 'tracker-all'; const now = nowIso_();
  for (var i = hr + 1; i < vals.length; i++) {
    const title = String(vals[i][C.title] || '').trim(); if (!title || /^#(REF|N\/A|VALUE)/.test(title)) continue;
    const emp = C.emp >= 0 ? String(vals[i][C.emp] || '').trim() : ''; const due = C.due >= 0 ? fmtD(raw[i][C.due]) : '';
    const k = key_(title, due, emp); if (keys[k]) { skipped++; continue; } keys[k] = true;
    let pid = '';
    if (emp && !/^#/.test(emp)) { pid = people[emp.toLowerCase()]; if (!pid) { pid = 'e-' + Utilities.getUuid().slice(0, 8); people[emp.toLowerCase()] = pid; db.write({ op: 'set', path: 'ws/main/people/' + pid, data: { name: emp, kind: 'employee', dept: C.dept >= 0 ? String(vals[i][C.dept] || '').trim() : '', code: 'E-' + (++maxE), createdAt: now, source: 'Monthly Tasks Tracker / All' } }); } }
    const st = SM[String(C.status >= 0 ? vals[i][C.status] : '').trim().toLowerCase()] || 'todo';
    const rawRow = {}; vals[hr].forEach(function (h, j) { if (h && vals[i][j] !== '' && j <= Math.max(C.status, C.emp, C.due) + 1) rawRow[h] = vals[i][j]; });
    const tid = 'tr-' + Utilities.getUuid().slice(0, 12);
    db.write({ op: 'set', path: 'ws/main/tasks/' + tid, data: { title: title, status: st, priority: 'p3', progress: st === 'done' ? 100 : 0, assignee: pid, dept: C.dept >= 0 ? String(vals[i][C.dept] || '').trim() : '', start: C.entry >= 0 ? fmtD(raw[i][C.entry]) : '', due: due,
      year: C.year >= 0 ? String(vals[i][C.year] || '').replace('.0', '') : '', month: C.month >= 0 ? String(vals[i][C.month] || '') : '', excelNo: C.no >= 0 ? String(vals[i][C.no] || '') : '', source: 'Monthly Tasks Tracker / All / صف ' + (i + 1), importBatch: batch, raw: rawRow,
      code: 'T-' + (++maxT), createdAt: now, lastUpdate: now, log: [{ at: now, text: 'سُحبت من ورقة All في Monthly Tasks Tracker' + (C.status >= 0 && !vals[i][C.status] ? ' (بلا حالة في الملف ← لم تبدأ)' : '') }] } });
    added++;
  }
  db.flush();
  Logger.log('أُضيفت ' + added + ' مهمة، وتُجوهل ' + skipped + ' مكررة');
  return { added: added, skipped: skipped };
}
function nameOf_(docs, pid) { const d = docs['ws/main/people/' + pid]; return d ? d.name : ''; }
function key_(title, due, emp) { return [String(title || '').trim().toLowerCase(), due || '', String(emp || '').trim().toLowerCase()].join('|'); }
function installTrackerSync() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'importTrackerAll') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('importTrackerAll').timeBased().everyHours(1).create();
  Logger.log('سيُسحب كل ساعة أي مهام جديدة من ورقة All');
}
